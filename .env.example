# PostgreSQL connection string.
# Local dev (docker): docker run -d --name sandlot-pg -e POSTGRES_PASSWORD=sandlot -e POSTGRES_DB=sandlot -p 5432:5432 postgres:16
DATABASE_URL="postgresql://postgres:sandlot@localhost:5432/sandlot"

# Secret used to sign session JWTs — set a long random value in production.
SESSION_SECRET="change-me-in-production-sandlot-secret"

# Optional recovery hatch: the account with this email is always granted
# the owner (super admin) role, on registration or next login.
# ADMIN_EMAIL=you@example.com

# Optional SMTP settings for real email delivery. Without SMTP_HOST,
# emails are logged to the console and recorded in the EmailLog table.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="The Sandlot <noreply@yourdomain.com>"
